      "DS13": "restored original mux and motion_session register block"
    },
    {
      "severity": "critical_difference",
      "item": "STOP/HOLD feedback history",
      "detail": "During cancel planner tracks target_wide to encoder_wide and coordinates holds encoder_local=10000. ADB1 manual path continues mapped_encoder relative to encoder_zero; DS12 feeds forced center through running P/D history even while motor is disabled."
    },
    {
      "severity": "qualification",
      "item": "HOLD origin",
      "detail": "DS12 reanchor initializes target=0, but cancel tracks current encoder_wide. In running HOLD target freezes at last cancel position, not necessarily zero. With same anchor and IP570 target=0, steady mathematical feedback matches except pipeline latency and prior history; no claim this alone explains all oscillation."
    },
    {
      "severity": "unchanged",
      "item": "numeric chain",
      "detail": "ADC64/50000 clocks; ADC_WORD_GUARD=1; requested_fast=1; fast P 1/5ms; D5/25ms; BETA_Q24=732284; Q4 angle mapping 9415911/2^25 around3085; fixed target10000; moto=balance-position clipped6900; one MOTOR_SIGN=-1; PWM25us/command100us."
    },
    {
      "severity": "difference",
      "item": "guards",
      "detail": "DS12 always motion_fault; unconditional fast_mapping_fault; different source-angle guard representation and split motor-invalidate wiring. DS13 restores hand-balance selection and source_window_bad guard, split invalidate with kit_changed."
    },
    {
      "severity": "difference",
      "item": "gain/adaptive features",
      "detail": "DS12 defaults S1 and structurally zeros both I words; ADB1 defaults49,0,260,25,0,620 and permits adaptation. Explicit same S1 and initially disabled adaptation are required for fair manual comparison."
    },
    {
      "severity": "confirmed_gate",
      "item": "BEGIN",
      "detail": "DS12 requires velocity_valid, abs(tracking_error)<=5, abs(measured_velocity)<=10 plus idle reference velocity/acceleration. Measured velocity=(100ms encoder difference)*10. This is a planner gate, not the source of PID D."
    }
